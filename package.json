{
  "name": "study-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "npm run build && wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply study-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply study-hub-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:content": "wrangler deploy --config content-worker/wrangler.toml"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.62.0",
    "aws4fetch": "^1.0.20",
    "docx-preview": "^0.3.5",
    "dompurify": "^3.2.3",
    "fflate": "^0.8.2",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.4",
    "nanoid": "^5.0.9",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sonner": "^1.7.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^4.0.0"
  }
}
